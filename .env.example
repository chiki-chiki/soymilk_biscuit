# Supabase（Project Settings → API Keys）
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# サーバー専用。フィードバックの保存・管理者メールの取得・アカウント削除に使う
SUPABASE_SECRET_KEY=

# サイトの URL（通知メール内のリンクに使う）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile（未設定なら開発環境ではボット判定を省略）
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend（未設定なら通知メールを送らない）
RESEND_API_KEY=
FEEDBACK_FROM_EMAIL="豆乳ビスケット図鑑 <noreply@example.com>"

# 送信回数制限用の IP ハッシュのソルト（ランダムな長い文字列）
IP_HASH_SALT=

# ローカルの Supabase で Google ログインを使う場合
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
